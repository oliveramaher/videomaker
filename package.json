{
  "name": "videomaker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/capture.mjs",
    "./prepare": "./src/prepare-demo.mjs",
    "./remotion": "./video/ProductDemo.jsx",
    "./explore": "./src/explore/agent.mjs",
    "./make-ad": "./src/make-ad.mjs"
  },
  "scripts": {
    "capture": "node src/cli.mjs",
    "studio": "remotion studio video/index.jsx --no-open --public-dir=output/video-assets",
    "render": "remotion render video/index.jsx ProductDemo --public-dir=output/video-assets",
    "prepare-demo": "node src/prepare-cli.mjs",
    "demo-app": "node fixtures/demo-app/server.mjs",
    "login": "node src/explore-cli.mjs login",
    "explore": "node src/explore-cli.mjs explore",
    "test": "node --test",
    "make-ad": "node src/explore-cli.mjs make-ad"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@remotion/cli": "4.0.541",
    "playwright": "1.62.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.541",
    "zod": "4.6.7"
  }
}
